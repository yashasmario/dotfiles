#!/bin/bash

current=$(readlink ~/.local/share/icons/cross/cursors/left_ptr)

if [[ "$current" == *"Windows-Aero-Black"* ]]; then
    target=/usr/share/icons/Adwaita/cursors/left_ptr
else
    target=~/.local/share/icons/Windows-Aero-Black/cursors/cross
fi

cd ~/.local/share/icons/cross/cursors || exit 1

rm -f left_ptr arrow default top_left_arrow

for name in left_ptr arrow default top_left_arrow; do
    ln -s "$target" "$name"
done

hyprctl setcursor Adwaita 24
sleep 0.1
hyprctl setcursor cross 24
